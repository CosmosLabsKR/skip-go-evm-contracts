# ─────────────────────────────────────────────────────────────────────────────
# Route (hop 2) — Avalanche → Injective. These three values ARE the forwarder's
# CREATE2 salt, so changing any of them changes the predicted mintRecipient.
# ─────────────────────────────────────────────────────────────────────────────
ROUTE_SENDER=0xd706c3F4aD08F695ddC8a301a6a63B263a0A3Ac3
ROUTE_DOMAIN=29
# REQUIRED, no default: the final recipient on Injective, as 32 bytes.
# For an Injective EVM address, left-pad it: 0x000000000000000000000000<20-byte address>
ROUTE_MINT_RECIPIENT=

# ─────────────────────────────────────────────────────────────────────────────
# Avalanche Fuji (transit chain, hop 1 destination)
# ─────────────────────────────────────────────────────────────────────────────
EVM_RPC=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_DOMAIN=1
TRANSIT_EXECUTOR=0x015218cFdce7E8285DfFB16c457054EE2a441025
TRANSIT_FACTORY=0x1523857349959aa02Efb00736151eaF4fD462081

# Operator key for TransitExecutor, hex. Only needed for `execute --send`; the
# executor rejects any other caller (NotOperator), and the tool checks that first.
EVM_PK=

# ─────────────────────────────────────────────────────────────────────────────
# Onward burn — only used by `execute`, ignored by `burn`
# ─────────────────────────────────────────────────────────────────────────────
# Relayer fee, taken out of the minted amount on Avalanche (uusdc). Must be > 0
# and < the minted amount, or the transit reverts (ZeroFee / FeeExceedsMinted).
FEE_AMOUNT=
# CCTP v2 max fee for the Injective hop (uusdc). Must be < (minted - FEE_AMOUNT).
MAX_FEE=0
# 1000 = fast/soft finality, 2000 = standard/hard. CCTP v2 accepts nothing else.
MIN_FINALITY_THRESHOLD=2000
# Who may call receiveMessage on Injective, as 32 bytes. Must be non-zero —
# leaving it open is the nonce-griefing path this design exists to close.
#
# This is the ONE value `mint` cannot work around: it is burned into the onward
# message, and only this address can ever submit it on Injective. It must be an
# account you hold the key to on Injective — an Avalanche contract address (the
# forwarder, the executor) is not one, and funds sent under it cannot be minted.
ONWARD_DESTINATION_CALLER=

# ─────────────────────────────────────────────────────────────────────────────
# Injective (hop 3 — where the funds finally land). Its EVM runs the stock CCTP
# v2 contracts, so the last hop is an ordinary receiveMessage with no contract
# of ours involved. The transmitter address is Circle's and is the same on every
# EVM chain; `mint` verifies localDomain() == 29 before using it.
# ─────────────────────────────────────────────────────────────────────────────
INJECTIVE_RPC=https://sentry.evm-rpc.injective.network
INJECTIVE_MESSAGE_TRANSMITTER=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
# Key for the ONWARD_DESTINATION_CALLER account. Falls back to EVM_PK when unset.
INJECTIVE_PK=

# Circle's attestation service. Sandbox serves testnet; mainnet is https://iris-api.circle.com
# Hops 1-2 read the v1 API (source domain 4); hop 3 reads the v2 API (source
# domain 1). They are separate indexes — a v1 lookup of an Avalanche hash 404s.
IRIS_API=https://iris-api-sandbox.circle.com
NOBLE_DOMAIN=4

# ─────────────────────────────────────────────────────────────────────────────
# Noble (source of the burn) — grand-1 is testnet, noble-1 is mainnet
# ─────────────────────────────────────────────────────────────────────────────
NOBLE_RPC=https://noble-testnet-rpc.polkachu.com
NOBLE_CHAIN_ID=grand-1
BURN_TOKEN=uusdc
GAS_PRICE=0.1uusdc
GAS_LIMIT=300000

# Raw secp256k1 private key in hex (32 bytes, 0x prefix optional). Only needed for
# --broadcast; leave empty to build an unsigned tx and set NOBLE_SENDER (or pass --from).
# The noble1... address is derived from it, so NOBLE_SENDER is ignored when this is set.
NOBLE_PK=
NOBLE_SENDER=

# Optional default burn amount in uusdc; --amount / --usdc override it.
AMOUNT=
