# 여기 있는 값은 전부 커맨드 플래그로 덮어쓸 수 있다 (플래그 > .env > 기본값).
# 예: npm run check -- --chain polygon --env prod --recipient 0x<주소>
# 전체 목록은 아무 커맨드에나 --help.
#
# ⚠️ EVM_RPC를 박아두면 --chain을 이긴다. 체인을 바꿔 가며 쓸 거면 비워둘 것.

# ─────────────────────────────────────────────────────────────────────────────
# 경유 체인 (hop 1의 도착지 — 포워더가 사는 곳)
#
# 기본값 없음. 이 두 값이 나머지 체인 관련 설정을 전부 결정한다:
# CCTP 도메인, RPC, executor/factory 주소, 어테스테이션 서비스, Noble 네트워크.
#
#   TRANSIT_CHAIN   avalanche(43114, 도메인 1) | polygon(137, 도메인 7)
#                   fuji(43113, 도메인 1) | amoy(80002, 도메인 7)
#   DEPLOY_ENV      prod | dev
#
# ⚠️ PROD의 executor·factory 주소는 Avalanche와 Polygon에서 **동일하다**(같은
#    deployer/nonce). 주소만 봐서는 어느 체인인지 알 수 없다. 구분되는 건 체인 ID와
#    CCTP 도메인뿐이고, 도구는 매 실행마다 이 둘을 온체인에서 읽어 대조한다.
#    테스트넷에는 배포가 하나뿐이라 DEPLOY_ENV=dev만 있다.
# ─────────────────────────────────────────────────────────────────────────────
TRANSIT_CHAIN=polygon
DEPLOY_ENV=prod

# 아래는 전부 선택. 비워두면 위 두 값에서 유도된다.
# EVM_RPC=https://polygon-bor-rpc.publicnode.com
# TRANSIT_EXECUTOR / TRANSIT_FACTORY는 둘 다 주거나 둘 다 비운다. 주면 DEPLOY_ENV보다
# 우선하며, 레지스트리에 없는 배포를 가리킬 때만 쓴다.
# TRANSIT_EXECUTOR=
# TRANSIT_FACTORY=
# TRANSIT_DOMAIN=

# TransitExecutor의 오퍼레이터 키, hex. `execute --send`에만 필요하다.
# executor는 다른 호출자를 전부 거부하며(NotOperator), 도구가 이것을 가장 먼저 확인한다.
EVM_PK=

# ─────────────────────────────────────────────────────────────────────────────
# 라우트 (hop 2) — 경유 체인 → Injective. 이 세 값이 곧 포워더의 CREATE2 salt다.
# 하나라도 바뀌면 예측되는 mintRecipient가 바뀐다.
# ─────────────────────────────────────────────────────────────────────────────
ROUTE_SENDER=0xd706c3F4aD08F695ddC8a301a6a63B263a0A3Ac3
ROUTE_DOMAIN=29
# 필수, 기본값 없음: Injective에서의 최종 수취인, 32바이트.
# Injective EVM 주소라면 왼쪽을 0으로 채운다: 0x000000000000000000000000<20바이트 주소>
ROUTE_MINT_RECIPIENT=

# ─────────────────────────────────────────────────────────────────────────────
# onward burn — `execute`만 사용하고 `burn`은 무시한다
#
# ⚠️ 릴레이어 수수료는 없어졌다. TransitForwarder v2는 Circle의 TokenMessenger를 직접
#    부르고 아무것도 떼지 않는다. FEE_AMOUNT는 컨트랙트 시그니처에서 제거되었으며,
#    설정에 남아 있으면 도구가 조용히 무시하지 않고 에러를 낸다.
# ─────────────────────────────────────────────────────────────────────────────
# Injective hop의 CCTP v2 최대 수수료(uusdc). Circle이 도착 측에서 떼는 값이지 우리
# 수수료가 아니다. 민팅된 금액보다 작아야 한다.
MAX_FEE=10
# 1000 = fast/soft 파이널리티, 2000 = standard/hard. CCTP v2는 이 둘만 받는다.
MIN_FINALITY_THRESHOLD=2000
# Injective에서 receiveMessage를 부를 수 있는 주체, 32바이트. 0이면 안 된다 —
# 열어두는 것은 이 설계가 막으려고 존재하는 바로 그 nonce 그리핑 경로다.
#
# `mint`가 우회할 수 없는 유일한 값이다. onward 메시지에 각인되며, Injective에서 그
# 메시지를 제출할 수 있는 주소는 영원히 이것 하나뿐이다. 반드시 Injective에서 키를
# 보유한 계정이어야 한다. 경유 체인의 컨트랙트 주소(포워더, executor)는 그런 계정이
# 아니고, 그 앞으로 보낸 자금은 민팅할 수 없다.
ONWARD_DESTINATION_CALLER=

# ─────────────────────────────────────────────────────────────────────────────
# Injective (hop 3 — 자금이 최종적으로 도착하는 곳). 이 체인의 EVM은 표준 CCTP v2
# 컨트랙트를 그대로 돌리므로, 마지막 hop은 우리 컨트랙트가 개입하지 않는 평범한
# receiveMessage다. 트랜스미터 주소는 Circle의 것이고 모든 EVM 체인에서 동일하며,
# `mint`가 사용 전에 localDomain() == 29 인지 확인한다.
#
# 아래 기본값은 메인넷이다. 테스트넷(fuji/amoy)으로 돌린다면 Injective 테스트넷
# RPC를 직접 지정해야 한다.
# ─────────────────────────────────────────────────────────────────────────────
INJECTIVE_RPC=https://sentry.evm-rpc.injective.network
INJECTIVE_MESSAGE_TRANSMITTER=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
# ONWARD_DESTINATION_CALLER 계정의 키. 비워두면 EVM_PK로 폴백한다.
INJECTIVE_PK=

# ─────────────────────────────────────────────────────────────────────────────
# Noble (burn의 출발지)와 어테스테이션. 둘 다 TRANSIT_CHAIN의 네트워크 등급을 따라
# 자동으로 정해지므로 보통 건드릴 필요가 없다.
#   메인넷  noble-1 / https://iris-api.circle.com
#   테스트넷 grand-1 / https://iris-api-sandbox.circle.com
# 메인넷 burn을 sandbox로 조회하면 영원히 404다.
# hop 1-2는 v1 API(출발 도메인 4)를, hop 3은 v2 API(출발 도메인 1 또는 7)를 읽는다.
# 둘은 별개의 인덱스라서, 경유 체인 해시를 v1로 조회하면 404가 난다.
# ─────────────────────────────────────────────────────────────────────────────
# NOBLE_RPC=
# NOBLE_CHAIN_ID=
# IRIS_API=
NOBLE_DOMAIN=4
BURN_TOKEN=uusdc
GAS_PRICE=0.1uusdc
GAS_LIMIT=300000

# secp256k1 개인키 원본, hex (32바이트, 0x 접두사는 선택). --broadcast에만 필요하다.
# 비워두면 서명하지 않은 tx를 만들며, 이때는 NOBLE_SENDER를 설정하거나 --from을 넘긴다.
# 이 값이 있으면 noble1... 주소가 여기서 파생되므로 NOBLE_SENDER는 무시된다.
NOBLE_PK=
NOBLE_SENDER=

# 기본 burn 금액(uusdc), 선택. --amount / --usdc가 우선한다.
AMOUNT=
